# =============================================================================
# EduPlatform dashboard — environment
#
# Copy to .env.local and fill in. Never commit a filled-in copy.
#
# Note what is NOT here: there is no NEXT_PUBLIC_* variable for the API. The
# browser never talks to the backend directly — it calls this application's own
# /api/proxy route, which attaches the access token server-side. That is what
# lets the token live in an HTTP-only cookie instead of in JavaScript, and it
# means the backend's address is never published to the client.
# =============================================================================

# --- required ----------------------------------------------------------------

# Base URL of the existing NestJS API, including its global prefix.
# Local development against the backend's default:
API_BASE_URL=http://localhost:3000/api/v1
# Production example:
# API_BASE_URL=https://api.example.com/api/v1


# --- optional ----------------------------------------------------------------

# How long to wait for the API before giving up on one request (milliseconds).
# API_TIMEOUT_MS=20000

# Whether session cookies carry the Secure flag. Defaults to on in production
# and off in development. A Secure cookie is silently dropped over plain HTTP,
# so leave this off unless the dashboard is served over HTTPS.
# SECURE_COOKIES=true

# The origin this dashboard is served from. When set, the proxy refuses any
# mutating request whose Origin header does not match it. Leave unset to use
# the request's own origin, which is correct for most deployments.
# APP_ORIGIN=https://dashboard.example.com

# Timezone used to render every date. The platform operates in Egypt, so an
# administrator abroad reads the same expiry date as the student it applies to.
# PLATFORM_TIMEZONE=Africa/Cairo
# NEXT_PUBLIC_PLATFORM_TIMEZONE=Africa/Cairo


# --- end-to-end tests only ---------------------------------------------------
# Ports Playwright uses for the app and the stub API it runs against.
# APP_PORT=4598
# STUB_API_PORT=4599
#
# Escape hatch for environments where Playwright cannot download its browser.
# CHROMIUM_PATH=/path/to/chrome
